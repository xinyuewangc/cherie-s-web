# -----------------------------------------------------------------------------
# Public app URL
# -----------------------------------------------------------------------------
# Local: http://127.0.0.1:4317
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317

# -----------------------------------------------------------------------------
# Notion CMS
# -----------------------------------------------------------------------------
# Keep the real NOTION_TOKEN only in .env.local and Vercel Environment Variables.
# Never commit a real token to GitHub.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=

# -----------------------------------------------------------------------------
# Legacy template services
# -----------------------------------------------------------------------------
# The portfolio site does not require these for the public pages.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN=
DATABASE_URL=
SMTP_FROM=
POSTMARK_API_TOKEN=
POSTMARK_SIGN_IN_TEMPLATE=
POSTMARK_ACTIVATION_TEMPLATE=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PLAN_ID=
